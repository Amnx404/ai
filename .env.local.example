# Copy values from your local .env, then make sure these local service URLs stay set.

DATABASE_URL="postgresql://postgres:password@localhost:5432/website_ai"

NEXTAUTH_URL="http://localhost:3001"
callback_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me-in-production"
WIDGET_JWT_SECRET="change-me-in-production"

SCRAPER_PIPELINE_BASE_URL="http://localhost:8787"
SCRAPER_SCRAPE_PROVIDER="cloudflare"
SCRAPER_HOST="127.0.0.1"
SCRAPER_PORT="8787"

# Cloudflare Browser Run provider
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Required for answers/upload
OPENROUTER_API_KEY=""
PINECONE_API_KEY=""
PINECONE_INDEX="website-ai"
PINECONE_INDEX_HOST=""
PINECONE_EMBED_MODEL="llama-text-embed-v2"

# Optional
RESEND_API_KEY=""
RESEND_FROM="Website Assistant <onboarding@resend.dev>"
SCRAPER_FINETUNE_MODEL="google/gemini-2.5-flash-lite"
FINETUNE_PROMPT=""
