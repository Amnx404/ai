{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "package.json",
      "package-lock.json",
      "next.config.js",
      "postcss.config.cjs",
      "tailwind.config.ts",
      "tsconfig.json",
      "prisma/**",
      "public/**",
      "scripts/**",
      "src/**",
      "railway.json"
    ],
    "buildCommand": "export SKIP_ENV_VALIDATION=1 && npm run db:generate && npm run build"
  },
  "deploy": {
    "preDeployCommand": [
      "npx prisma migrate deploy"
    ],
    "startCommand": "npm start",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
